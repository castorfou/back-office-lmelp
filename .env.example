# Copiez ce fichier vers .env et remplissez les valeurs pour votre environnement.
# .env n'est jamais commité (voir .gitignore).

# MongoDB
MONGODB_URL=mongodb://localhost:27017/masque_et_la_plume

# Azure OpenAI (utilisé pour l'extraction de métadonnées RadioFrance,
# la classification RSS et la génération de résumés)
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_API_VERSION=2024-09-01-preview
AZURE_DEPLOYMENT_NAME=gpt-4o

# Calibre (optionnel)
# Chemin hôte vers votre bibliothèque Calibre
CALIBRE_HOST_PATH=/home/user/Calibre Library
# Tag pour filtrer une bibliothèque virtuelle (optionnel)
# Exemple: CALIBRE_VIRTUAL_LIBRARY_TAG=guillaume
CALIBRE_VIRTUAL_LIBRARY_TAG=

# Anna's Archive (Issue #188)
# URL de base pour Anna's Archive (optionnel)
# Si non définie, le backend scrape Wikipedia pour récupérer l'URL actuelle
# Exemples: https://fr.annas-archive.se, https://annas-archive.li
ANNAS_ARCHIVE_URL=https://fr.annas-archive.se

# RSS Le Masque et la Plume (Issue #295)
# URL du flux RSS France Inter (optionnel, valeur par défaut déjà correcte)
RSS_MASQUE_ET_LA_PLUME_URL=https://radiofrance-podcast.net/podcast09/rss_14007.xml
# Durée minimale en minutes pour retenir un épisode (optionnel, défaut 15)
RSS_DUREE_MINI_MINUTES=15
# Répertoire de stockage des fichiers audio téléchargés (optionnel)
# Par défaut: <racine_projet>/data/audios en développement local
# En production Docker (docker-lmelp): /app/audios (volume monté)
AUDIO_STORAGE_PATH=

# Notifications ntfy.sh en fin de synchronisation RSS (optionnel, no-op si absent)
# Exemple: NTFY_SERVER_URL=https://ntfy.sh puis abonnez-vous à https://ntfy.sh/<votre-topic>
NTFY_SERVER_URL=
NTFY_TOPIC=

# Transcription PGX (Issue #302)
# Station GPU dédiée pour la transcription automatisée des épisodes — voir
# docs/user/transcription-pgx.md et docs/dev/environment-variables.md
# IP directe recommandée (pas un nom .local, résolution peu fiable selon l'environnement)
PGX_HOST=
PGX_USER=
# Chemin de la clé privée SSH dédiée — générée automatiquement si absente à cet emplacement
# En production Docker (docker-lmelp): /app/keys/pgx_ed25519 (volume monté)
PGX_SSH_KEY_PATH=
PGX_REMOTE_AUDIO_ROOT=
PGX_REMOTE_TRANSCRIPTION_ROOT=
# Optionnelles (valeurs par défaut dans le code si absentes)
# PGX_TRANSCRIPTION_TIMEOUT_S=1800
# PGX_POLL_INTERVAL_S=10
